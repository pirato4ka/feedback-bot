# Токен бота из @BotFather (обязательно)
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Telegram ID администраторов через запятую (обязательно)
# Узнать свой ID: @userinfobot
ADMIN_IDS=111111111,222222222

# Общий чат/канал администрации для обращений (необязательно).
# Если не задан, обращения приходят в личные чаты администраторов из ADMIN_IDS.
# Бот должен быть участником чата и иметь право писать сообщения.
# ADMIN_CHAT_ID=-1001234567890

# Путь к файлу базы данных (необязательно, по умолчанию data/bot.db)
# DB_PATH=data/bot.db

# Антифлуд: сколько секунд между обращениями одного пользователя (по умолчанию 60)
REPORT_COOLDOWN_SECONDS=60

# Как часто планировщик проверяет расписание рассылок, секунды (по умолчанию 20)
SCHEDULER_TICK_SECONDS=20

# Скорость рассылки, сообщений в секунду (по умолчанию 20)
BROADCAST_RATE_PER_SECOND=20

# Смещение часового пояса для отображения времени (по умолчанию 3 — МСК)
DISPLAY_UTC_OFFSET=3
